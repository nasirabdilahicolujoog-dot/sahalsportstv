<resources>
    <style name="Theme.Sahal" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#09051A</item>
        <item name="android:navigationBarColor">#09051A</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#09051A</item>
    </style>
    <style name="Theme.Sahal.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#09051A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Sahal</item>
    </style>
</resources>
