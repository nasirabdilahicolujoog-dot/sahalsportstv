{
  "name": "sahal-sports-tv-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "reconcile-payments": "node --env-file-if-exists=.env scripts/reconcile-payments.js",
    "test": "node scripts/test-postgres.js",
    "test:external": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  }
}
