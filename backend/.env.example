# Copy to .env locally; never commit real credentials. Node.js 24+.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# Create a dedicated database and least-privilege application login before migrating.
DATABASE_URL=postgresql://sahal:REPLACE_PASSWORD@127.0.0.1:5432/sahal_sports
# Generate with: node -p "require('node:crypto').randomBytes(32).toString('base64')"
# Required: 32 random bytes as base64, or any random secret of 32+ characters (hashed to 32 bytes). Back up securely; do not rotate blindly.
PROVIDER_ENCRYPTION_KEY=
SESSION_HOURS=168
# Exact HTTPS origin used by the Android app, without /v1. No request Host trust.
PUBLIC_BASE_URL=http://127.0.0.1:8080
# HTTPS-only exact upstream hostnames, comma separated. Wildcards/IP literals forbidden.
STREAM_ALLOWED_HOSTS=
# Optional exact HTTPS provider API hostnames. No wildcard or private addresses.
PROVIDER_ALLOWED_HOSTS=
# Explicit local ES module exporting adapters. Empty means 503; no simulated payments.
# See the interface and verification requirements in src/providers.js.
PAYMENT_ADAPTER_MODULE=
# Optional real FCM HTTP v1 integration using a Google service-account JSON file.
FCM_SERVICE_ACCOUNT_FILE=
FCM_TOPIC_PREFIX=sahal
# Public TLS terminator should forward /v1 without path changes and Authorization intact.
# Leave unset unless exactly one trusted proxy is bound in front of this service.
TRUST_PROXY_HOPS=0
# CLI/env only, used by npm run create-admin. No defaults, never stored in source.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
# Optional PostgreSQL binaries for npm test; tests never use DATABASE_URL.
PG_BIN=C:/Program Files/PostgreSQL/18/bin
